# Migration runner image — carries db/ (migrations + the content-hash-locked
# runner) and psycopg2. Run by the Helm pre-install/upgrade hook.
#   docker build -f deploy/docker/Dockerfile.migrate -t ghcr.io/cochero/migrate:<sha> .
FROM python:3.13-slim
WORKDIR /srv
RUN pip install --no-cache-dir psycopg2-binary
COPY db /srv/db
RUN useradd --system --no-create-home truvo
USER truvo
# TRUVO_DATABASE_URL is injected by the Helm hook (admin role)
CMD ["python", "db/migrate.py"]
