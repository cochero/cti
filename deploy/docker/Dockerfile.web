# Analyst console (React SPA) — multi-stage build.
#   docker build -f deploy/docker/Dockerfile.web -t ghcr.io/cochero/web:<sha> .
#
# Stage 1 builds the static bundle with the API base baked as '/' (Caddy
# routes /api to core; the SPA is served same-origin — no CORS surface).
# Stage 2 is nginx-alpine serving the immutable assets with SPA fallback
# routing (client-side routes like /priorities/CVE-… must return index.html).
FROM node:22-alpine AS build
WORKDIR /src

# dependency layer caches independently of source
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-fund --no-audit

COPY web/ ./
RUN npm run build


FROM nginx:1.31-alpine
COPY --from=build /src/dist /usr/share/nginx/html
COPY deploy/docker/web.nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
# immutable hashed assets get aggressive caching; index.html is never cached
# (a stale index references assets that no longer exist after a deploy)
HEALTHCHECK --interval=30s --timeout=3s \
  CMD wget -qO- http://localhost/ >/dev/null || exit 1
