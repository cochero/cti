# Caddy: automatic Let's Encrypt TLS + reverse proxy.
#
# CRITICAL: only the Django `core` and the static console are public. The
# FastAPI microservices have NO authentication of their own — they trust the
# network + service-identity signing. Exposing them to the internet would
# bypass all auth. Caddy routes ONLY to core (which enforces SSO/RBAC);
# the SPA is served by its nginx container (same origin -> no CORS).
{$TRUVO_DOMAIN} {
    encode gzip zstd
    # security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        # SPA CSP (security review M8): everything same-origin; inline
        # STYLE attributes only (React sets style props); no frames
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'"
        -Server
    }

    # API + SSO -> the authenticated Django core
    handle /api/* {
        reverse_proxy core:8000
    }
    handle /oidc/* {
        reverse_proxy core:8000
    }
    handle /admin/* {
        reverse_proxy core:8000
    }
    handle /static/* {
        reverse_proxy core:8000
    }

    # everything else -> the console's static server (SPA fallback inside)
    reverse_proxy web:80
}
