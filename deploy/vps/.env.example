# TRUVO production secrets. Copy to .env and fill with REAL values.
# bootstrap.sh generates strong random values for the blanks if you run it.
# NEVER commit the real .env (it is gitignored).

# --- your domain (DNS A-record must point at this VPS) ---
TRUVO_DOMAIN=app.example.com

# --- Postgres admin (migrations run as this; services do NOT) ---
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_strong_random

# --- the RLS app role connection (services connect as truvo_app) ---
# bootstrap.sh sets the truvo_app password to match this after migrations.
TRUVO_APP_DB_PASSWORD=CHANGE_ME_strong_random
TRUVO_APP_DB_URL=postgresql://truvo_app:CHANGE_ME_strong_random@postgres:5432/truvo

# --- object store ---
MINIO_USER=truvo
MINIO_PASSWORD=CHANGE_ME_strong_random

# --- vault root token (bootstrap captures this from `bao operator init`) ---
TRUVO_VAULT_TOKEN=SET_BY_BOOTSTRAP

# --- Django ---
DJANGO_SECRET_KEY=CHANGE_ME_50_random_chars
