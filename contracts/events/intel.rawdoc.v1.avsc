{
  "type": "record",
  "name": "RawDoc",
  "namespace": "truvo.intel.v1",
  "doc": "A collected artifact reference (Architecture v2 §4 Collection Layer). The raw bytes live content-addressed in the object store (evidence preservation, §5.2); this event carries only the pointer + provenance so extraction-svc can fetch, re-extract, or audit. Emitted by collector-svc; consumed by extraction-svc.",
  "fields": [
    {"name": "rawdoc_id", "type": "string", "doc": "UUIDv7"},
    {"name": "schema_version", "type": "string", "default": "1"},
    {"name": "source_id", "type": "string", "doc": "FK into provenance-svc source registry — must be pre-registered"},
    {"name": "collected_at_iso", "type": "string", "doc": "ISO-8601 UTC"},
    {"name": "artifact_bucket", "type": "string", "doc": "object-store bucket"},
    {"name": "artifact_key", "type": "string", "doc": "object-store key; content-addressed: <sha256>"},
    {"name": "artifact_sha256", "type": "string", "doc": "content hash; extraction verifies bytes against this before trusting them"},
    {"name": "content_type", "type": "string", "doc": "e.g. application/json, text/html, text/plain"},
    {"name": "content_bytes", "type": "int", "doc": "size in bytes"},
    {"name": "trust_class", "type": {"type": "enum", "name": "TrustClass", "symbols": ["OSINT", "DARK_WEB", "SOCIAL", "VENDOR_ADVISORY", "CERT", "FIRST_PARTY"]}, "doc": "mirrors source class; extraction quarantines untrusted classes more aggressively"},
    {"name": "origin_url", "type": ["null", "string"], "default": null, "doc": "where it was collected from, for audit; never fetched-from by extraction"}
  ]
}
